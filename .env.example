# 이 파일을 복사해서 ".env" 로 이름을 바꾼 뒤 실제 값을 입력하세요.
# ".env" 파일은 .gitignore 에 등록되어 있어 Git에 올라가지 않습니다.
# 아래 값들은 Phase 2 이후 단계에서 순차적으로 사용됩니다.

# ----- 카메라 (Phase 7) -----
CAMERA_HOST=192.168.x.x
CAMERA_HTTP_PORT=80
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=
CAMERA_PASSWORD=

# ----- MySQL (Phase 3) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thermal_event
DB_USERNAME=
DB_PASSWORD=

# ----- Firebase FCM (Phase 5) -----
# 서비스 계정 JSON 파일은 저장소 밖(예: C:\secrets\)에 두고 경로만 적습니다.
FIREBASE_CREDENTIALS_PATH=C:\secrets\firebase-service-account.json

# ----- 이벤트 중복 방지 (Phase 4) -----
EVENT_DEDUP_SECONDS=5
